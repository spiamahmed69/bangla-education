rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isEnrolled(courseId) {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }
    // কোর্সের দায়িত্বপ্রাপ্ত শিক্ষক কি না — কোর্স ডকের teacherUid দেখে।
    // শিক্ষক শুধু নিজের কোর্সের এনরোলমেন্টই পড়তে পারে, অন্য কোর্সেরটা নয়।
    function isTeacherOfCourse(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherUid == request.auth.uid;
    }

    // কোর্স ও লেসনের তথ্য (শিরোনাম/সময়কাল) সবাই পড়তে পারে — কিন্তু ভিডিও URL নয়
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      // ভিডিও URL: শুধু এনরোল করা শিক্ষার্থী আর অ্যাডমিন পড়তে পারে
      match /lessonAccess/{lessonId} {
        allow read: if isAdmin() || isEnrolled(courseId);
        allow write: if isAdmin();
      }
    }

    // রিভিউ: সবাই পড়তে পারে; লেখে শুধু কোর্স কেনা (এনরোল করা) শিক্ষার্থী —
    // একজন ইউজার এক কোর্সে একটাই রিভিউ দিতে পারে (আবার দিলে আগেরটা আপডেট হয়)।
    // নিজের রিভিউ নিজে আপডেট করতে পারে, মুছতে পারে শুধু অ্যাডমিন।
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isEnrolled(request.resource.data.courseId)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // প্রোগ্রেস: নিজেরটাই পড়ে/লেখে; অ্যাডমিন সব পড়তে পারে।
    // ডক আইডি uid_courseId, completedLessonIds-এ হাতে চিহ্ন দেওয়া শেষ ক্লাসগুলো থাকে —
    // ভিডিও দেখা স্বয়ংক্রিয়ভাবে মাপা হয় না, শিক্ষার্থী নিজে "সম্পন্ন" টিক দেয়।
    // নিয়ম ফাইল বদলালেই চালু হয় না — firestore.rules Firebase কনসোলে Publish করতে হবে।
    match /progress/{progressId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // কুইজ: পড়তে পারে শুধু কোর্স কেনা (এনরোল করা) শিক্ষার্থী আর অ্যাডমিন;
    // বানায়/বদলায়/মুছে শুধু অ্যাডমিন। কুইজ খালি থাকলে অ্যাডমিন বানাতে হবে।
    match /quizzes/{courseId} {
      allow read: if isAdmin() || isEnrolled(courseId);
      allow write: if isAdmin();
    }

    // লাইভ ক্লাস: সময়সূচি সবাই পড়তে পারে; বানায়/বদলায়/মুছে শুধু অ্যাডমিন।
    // জয়েন লিংক শুধু কোর্স কেনা শিক্ষার্থী আর অ্যাডমিনকে দেখানো হয় — সেটা অ্যাপের
    // কোডে নিয়ন্ত্রণ করা হয়, নিয়মে নয়। লাইভ ক্লাস সিড করা হয় না, অ্যাডমিন বানাবে।
    // নিয়ম ফাইল বদলালেই চালু হয় না — firestore.rules Firebase কনসোলে Publish করতে হবে।
    match /liveClasses/{liveId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // কুপন: সবাই পড়তে পারে (চেকআউটে যাচাই করতে হয়), লেখে/বদলায়/মুছে শুধু অ্যাডমিন।
    // কুপনের ফাইল বদলালেই নিয়ম চালু হয় না — firestore.rules Firebase কনসোলে
    // Publish করতে হবে, নইলে লাইভে কুপন পড়া/লেখা permission-denied হবে।
    match /coupons/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // পেমেন্ট সেটিংস: সবাই পড়তে পারে (নম্বর দেখানো লাগে), লেখে শুধু অ্যাডমিন
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // অর্ডার: নিজের অর্ডার নিজে বানাতে/পড়তে পারে; অ্যাডমিন সব পড়ে/সিদ্ধান্ত নেয়
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // এনরোলমেন্ট: নিজেরটা পড়তে পারে; বানায়/বদলায় শুধু অ্যাডমিন (অ্যাপ্রুভের সময়);
    // কোর্সের শিক্ষক শুধু নিজের কোর্সের এনরোলমেন্ট পড়তে পারে (ছাত্র সংখ্যা দেখার জন্য)।
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid)
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if isAdmin();
    }

    // নোটিফিকেশন: পেমেন্ট অ্যাপ্রুভ/বাতিলের খবর শুধু অ্যাপের ভেতরে দেখানো হয় —
    // ইমেইল বা SMS যায় না। বানায় শুধু অ্যাডমিন (অর্ডার সিদ্ধান্তের সময়);
    // পড়ে মালিক নিজে বা অ্যাডমিন; "পড়া হয়েছে" চিহ্ন ছাড়া আর কিছু বদলানো যায় না।
    // নিয়ম ফাইল বদলালেই চালু হয় না — firestore.rules Firebase কনসোলে Publish করতে হবে।
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.userId != null;
      allow update: if (isAdmin() || (signedIn() && resource.data.userId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ইউজার প্রোফাইল: নিজেরটা পড়ে/নিজের ডিভাইস আপডেট করে; অ্যাডমিন সব দেখে
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
